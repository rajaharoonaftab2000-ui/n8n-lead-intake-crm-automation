      ],
      "id": "64488f54-1bb8-4f6f-a59e-54d9e84a47d1",
      "name": "Loop Meetings"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\n\nconst d = String(e.description ?? '')\n  .replace(/<[^>]*>/g, ' ');\n\nconst id =\n  d.match(/CRM_DEAL_ID\\s*:\\s*(\\d+)/i)?.[1] ?? '';\n\nconst email = (\n  d.match(/CRM_EMAIL\\s*:\\s*([^\\s<]+)/i)?.[1] ?? ''\n).toLowerCase();\n\nconst guests = (e.attendees ?? [])\n  .map(a => String(a.email ?? '').toLowerCase());\n\nconst start = e.start?.dateTime;\n\nconst valid =\n  e.status !== 'cancelled' &&\n  !!e.id &&\n  !!id &&\n  !!email &&\n  guests.includes(email) &&\n  !!start;\n\nreturn [{\n  json: {\n    valid,\n    deal_id: id,\n    email,\n    event_id: e.id ?? '',\n    start: start ?? '',\n    event_key:\n      valid ? `${e.id}|${start}` : '',\n    event_link: e.htmlLink ?? '',\n    event_summary: e.summary ?? ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -144
      ],
      "id": "463b55e6-7596-4dd1-9428-984acf81a154",
      "name": "Parse Booking"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 4
          },
          "conditions": [
            {
              "id": "8a0eb388-f0eb-45ab-9dac-c2c951dc8475",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        608,
        -144
      ],
      "id": "4e2b339e-c090-4e78-b964-0e2175cbe22d",
      "name": "Valid Booking?"
    },
    {
      "parameters": {
        "url": "={{ 'https://api.hubapi.com/crm/v3/objects/deals/' + $('Parse Booking').item.json.deal_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "properties",
              "value": "pipeline,dealstage,aa_opportunity_key,aa_event_key"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        832,
        -160
      ],
      "id": "0f7da0d9-5b0d-4b45-a05e-685217f97284",
      "name": "Read Booked Deal"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\n\nconst b = $('Parse Booking').item.json;\nconst c = $('Booking Config').first().json;\n\nif (Number(r.statusCode) === 404) {\n  return [{\n    json: {\n      sync: false,\n      reason: 'Deal not found; review booking marker'\n    }\n  }];\n}\n\nif (Number(r.statusCode) !== 200) {\n  throw new Error(\n    `Booking deal lookup failed: ${r.statusCode}`\n  );\n}\n\nconst p = r.body.properties ?? {};\n\nconst correct =\n  p.pipeline === c.pipeline_id &&\n  String(p.aa_opportunity_key ?? '')\n    .split('|')[0] === b.email;\n\nconst canMove = [\n  c.stage_new,\n  c.stage_qualified,\n  c.stage_meeting\n].includes(p.dealstage);\n\nconst duplicate =\n  p.aa_event_key === b.event_key;\n\nreturn [{\n  json: {\n    sync: correct && canMove && !duplicate,\n\n    reason: !correct\n      ? 'Deal/email/pipeline mismatch'\n      : !canMove\n        ? 'Deal is beyond booking stage or closed'\n        : duplicate\n          ? 'Already synced'\n          : 'Ready'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -160
      ],
      "id": "fa8eefc8-fce2-4e02-b10b-74c2d71139a8",
      "name": "Booking Decision"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
